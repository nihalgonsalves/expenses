{
  "name": "@nihalgonsalves/expenses-backend",
  "description": "",
  "version": "0.0.1",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "dev": "run-p 'start' 'db:generate --watch'",
    "start": "node --enable-source-maps --env-file-if-exists=../../.env.app --watch ./src/worker.ts",
    "test": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:migration": "prisma migrate dev --name",
    "db:sql-lint": "pnpx squawk-cli",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "auth:generate": "BETTER_AUTH_CLI=true auth generate --output=./prisma/schema/auth.prisma",
    "prepare:local": "node bin/prepare-local-env.js",
    "prepare:demo": "node bin/demo.ts"
  },
  "dependencies": {
    "@better-auth/core": "1.7.2",
    "@better-auth/passkey": "1.7.2",
    "@better-auth/prisma-adapter": "1.7.2",
    "@nihalgonsalves/expenses-shared": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@sentry/node": "10.72.0",
    "@sentry/profiling-node": "10.72.0",
    "@simplewebauthn/server": "13.3.3",
    "@types/pg": "8.20.0",
    "better-auth": "1.7.2",
    "bullmq": "6.3.2",
    "nanoid": "6.0.1",
    "nodemailer": "9.0.6",
    "pg": "8.20.0",
    "rate-limiter-flexible": "11.2.0",
    "rrule": "2.8.1",
    "ua-parser-js": "2.0.10",
    "web-push": "3.6.7",
    "zod": "4.5.2"
  },
  "devDependencies": {
    "@faker-js/faker": "10.6.0",
    "@testcontainers/postgresql": "12.1.0",
    "@total-typescript/ts-reset": "0.6.1",
    "@types/nodemailer": "8",
    "@types/web-push": "3.6.4",
    "@vitest/coverage-v8": "4.1.11",
    "auth": "1.7.2",
    "msw": "2.15.0",
    "npm-run-all2": "9.0.3",
    "prisma": "7.10.0",
    "vitest": "4.1.11"
  }
}
