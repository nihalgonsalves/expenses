{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "extends": [
    "../../.oxlintrc.json",
    "../../node_modules/@nihalgonsalves/esconfig/.oxlintrc.react.json"
  ],
  "plugins": ["react", "vitest", "jsx-a11y", "node", "unicorn"],
  "ignorePatterns": ["./src/routeTree.gen.ts"],
  "rules": {
    "no-use-before-define": ["error", { "functions": false }],
    "typescript/no-misused-promises": [
      "error",
      {
        "checksVoidReturn": {
          "attributes": false
        }
      }
    ],

    "react/react-in-jsx-scope": "off",
    // TODO
    "react/error-boundaries": "warn",
    "react/exhaustive-effect-dependencies": "warn",
    "react/incompatible-library": "warn",
    "react/memo-dependencies": "warn",
    "react/no-deriving-state-in-effects": "warn",
    "react/no-unstable-nested-components": "warn",
    "react/set-state-in-effect": "warn",
    "react/capitalized-calls": "warn",
    "jsx-a11y/prefer-tag-over-role": "warn",
    "jsx-a11y/control-has-associated-label": "warn"
  },
  "overrides": [
    {
      "files": ["src/routes/**/*", "src/routeTree.gen.ts"],
      "rules": {
        "no-use-before-define": "off",
        "func-style": "off",
        "typescript/only-throw-error": "off",
        "unicorn/filename-case": "off"
      }
    },
    {
      "files": ["src/components/**/*"],
      "rules": {
        // allow default shadcn style
        "func-style": "off"
      }
    }
  ]
}
