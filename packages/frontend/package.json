  "version": "0.0.1",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "pnpm run --stream \"/^dev:.*/\"",
    "dev:vite": "VITE_ROOT=$(pwd) VITE_GIT_COMMIT_SHA=\"$(git rev-parse HEAD)$(git diff --quiet || echo '-dirty')\" VITE_ENV_NAME=local sh bin/dev-vite.sh --clearScreen=false --host --port 5173",
    "dev:storybook": "storybook dev --port 6006 --no-open",
    "build": "pnpm run --stream \"/^build:.*/\"",
    "build:vite": "vite build",
    "build:storybook": "VITE_STORYBOOK=1 storybook build --output-dir=./build/storybook",
    "gen:assets": "tsx bin/generate-assets.tsx",
    "start": "vite preview",
    "test": "vitest",
    "test:storybook": "vitest --config vitest.storybook.config.ts"
  },
