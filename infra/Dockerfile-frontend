# NODE_VERSION
FROM node:26-slim AS builder

ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
# "Pin versions in npm"
# hadolint ignore=DL3016
RUN npm install -g corepack && corepack enable

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

RUN mkdir -p /opt/app
WORKDIR /opt/app

COPY package.json .
COPY ./packages/frontend/package.json ./packages/frontend/
COPY ./packages/backend/package.json ./packages/backend/
COPY ./packages/shared/package.json ./packages/shared/
COPY ./packages/e2e/package.json ./packages/e2e/
COPY ./pnpm-lock.yaml .
COPY ./pnpm-workspace.yaml .
COPY ./patches/ ./patches/

RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile

COPY ./tsconfig.json ./tsconfig.base.json ./
COPY ./packages/frontend/ ./packages/frontend/
COPY ./packages/backend/ ./packages/backend/
COPY ./packages/shared/ ./packages/shared/
COPY ./packages/e2e/ ./packages/e2e/

WORKDIR /opt/app/packages/backend
RUN pnpm db:generate

WORKDIR /opt/app/packages/frontend

ARG VITE_ENV_NAME=production
ARG VITE_GIT_COMMIT_SHA
ARG VITE_SENTRY_DSN

ENV VITE_ENV_NAME=${VITE_ENV_NAME}
ENV VITE_GIT_COMMIT_SHA=${VITE_GIT_COMMIT_SHA}
ENV VITE_SENTRY_DSN=${VITE_SENTRY_DSN}

RUN --mount=type=secret,id=SENTRY_AUTH_TOKEN \
    --mount=type=secret,id=SENTRY_ORG \
    --mount=type=secret,id=SENTRY_PROJECT \
    SENTRY_AUTH_TOKEN="$(cat /run/secrets/SENTRY_AUTH_TOKEN 2>/dev/null || true)" \
    SENTRY_ORG="$(cat /run/secrets/SENTRY_ORG 2>/dev/null || true)" \
    SENTRY_PROJECT="$(cat /run/secrets/SENTRY_PROJECT 2>/dev/null || true)" \
    pnpm build:vite

# the image itself is 26 pinned to LTS
# hadolint ignore=DL3007
FROM gcr.io/distroless/nodejs26:latest
# NODE_VERSION

WORKDIR /app

COPY --from=builder /opt/app/packages/frontend/.output/ ./

ENV NODE_ENV=production

EXPOSE 3000

CMD ["--enable-source-maps", "./server/index.mjs"]
